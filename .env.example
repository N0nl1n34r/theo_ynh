# ============================================================================
# Theo Beta — Umgebungsvariablen (.env.example)
# Niemals echte Secrets ins Git-Repository committen!
# In Vercel unter Project Settings -> Environment Variables hinterlegen.
# ============================================================================

# Öffentliche Basis-URL der Bereitstellung (ohne abschließenden Schrägstrich)
NEXT_PUBLIC_SITE_URL=https://deine-domain.example

# Supabase (Region: Frankfurt / eu-central-1)
SUPABASE_URL=https://DEIN-PROJEKT-REF.supabase.co
SUPABASE_ANON_KEY=eyJ...oeffentlicher_anon_oder_publishable_key
# NUR Server/Serverless — niemals im Client-Bundle exponieren:
SUPABASE_SERVICE_ROLE_KEY=eyJ...geheimer_service_role_key

# Geschlossene Beta: Registrierung erfordert gültigen Einladungscode
INVITE_REQUIRED=true

# Transaktionaler E-Mail-Versand (EU-Empfehlung: Brevo API oder eigenes EU-SMTP)
# Option A — Brevo HTTP API (empfohlen für Serverless in fra1)
BREVO_API_KEY=
# Option B — Klassisches SMTP (ebenfalls in Supabase Auth -> SMTP Settings eintragen)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Theo <hallo@beispiel-theo.de>"
MAIL_REPLY_TO="hallo@beispiel-theo.de"

# Schutz-Salt für datensparsames Rate-Limiting (SHA-256 Hash, keine Klartext-IPs)
RATE_LIMIT_SALT=bitte-zufaelligen-string-setzen

# Optional ab Meilenstein M5 — Zahlung (Stripe EU, Bestandsschutz 29 €/290 €)
# Solange leer, läuft die Zahlung auf Anfrage / Pilot-Freischaltung ohne Live-Abbuchung.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY_29=
STRIPE_PRICE_YEARLY_290=
